QMainWindow {
    background-color: #fbfaf7;
}

QWidget {
    background-color: #fbfaf7;
    color: #37352f;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QLabel {
    background: transparent;
    color: #6b6358;
}

QLabel#title {
    font-size: 15px;
    font-weight: bold;
    color: #37352f;
    padding: 6px 0;
}

QLabel#status {
    color: #9b9487;
    font-size: 11px;
}

QLineEdit {
    background-color: #faf9f6;
    border: 1px solid #e4dfd7;
    border-radius: 6px;
    padding: 8px 10px;
    color: #37352f;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #5a8db5;
}

QLineEdit[readOnly="true"] {
    color: #9b9487;
    background-color: #f8f5f1;
}

QPushButton {
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: bold;
    border: none;
}

QPushButton#browse_btn {
    background-color: #ece8e0;
    color: #37352f;
}

QPushButton#browse_btn:hover {
    background-color: #e0dbd1;
}

QPushButton#convert_btn {
    background-color: #5a8db5;
    color: white;
    padding: 10px 16px;
}

QPushButton#convert_btn:hover {
    background-color: #4d7d9f;
}

QPushButton#convert_btn:disabled {
    background-color: #b8cad8;
    color: #e8e4db;
}

QPushButton#xlsx_btn {
    background-color: #4a9c6c;
    color: white;
    padding: 10px 16px;
}

QPushButton#xlsx_btn:hover {
    background-color: #3d8259;
}

QPushButton#xlsx_btn:disabled {
    background-color: #b8cad8;
    color: #e8e4db;
}

QPushButton#theme_btn {
    background-color: transparent;
    color: #6b6358;
    font-size: 14px;
    padding: 4px 10px;
    border: 1px solid #e4dfd7;
}

QPushButton#theme_btn:hover {
    background-color: #ece8e0;
}

QComboBox {
    background-color: #faf9f6;
    border: 1px solid #e4dfd7;
    border-radius: 6px;
    padding: 8px 10px;
    color: #37352f;
    font-size: 12px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #5a8db5;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow {
    image: none;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #faf9f6;
    border: 1px solid #e4dfd7;
    color: #37352f;
    selection-background-color: #5a8db5;
    selection-color: white;
    outline: none;
}

QProgressBar {
    background-color: #ece8e0;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #5a8db5;
    border-radius: 3px;
}

QFrame#header {
    background-color: #f5f1eb;
    border-bottom: 1px solid #e8e4db;
    padding: 12px 16px;
}

QScrollArea {
    border: none;
    background: transparent;
}
